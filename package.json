{
  "name": "foresttask",
  "productName": "ForestTask",
  "version": "0.1.0",
  "description": "A graphical project & task tree — projects are big branches, tasks are the small ones. With an AI chat box powered by your own Claude or OpenAI key.",
  "main": "electron/main.js",
  "author": "Aryana Haghjoo",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:all": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aryana.foresttask",
    "productName": "ForestTask",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "ForestTask ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
